<UserControl
    x:Class="Ryujinx.Ava.UI.Controls.ApplicationGridView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:helpers="clr-namespace:Ryujinx.Ava.UI.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Focusable="True"
    mc:Ignorable="d"
    x:DataType="viewModels:MainWindowViewModel">
    <UserControl.Styles>
        <Style Selector="Image.homeCover.small">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="112" />
        </Style>
        <Style Selector="Image.homeCover.normal">
            <Setter Property="Width" Value="160" />
            <Setter Property="Height" Value="160" />
        </Style>
        <Style Selector="Image.homeCover.large">
            <Setter Property="Width" Value="196" />
            <Setter Property="Height" Value="196" />
        </Style>
        <Style Selector="Image.homeCover.huge">
            <Setter Property="Width" Value="228" />
            <Setter Property="Height" Value="228" />
        </Style>
        <Style Selector="Button.homeQuickAction">
            <Setter Property="Background" Value="{DynamicResource HomeSurfaceColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HomeBorderColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.homeQuickAction:pointerover">
            <Setter Property="Background" Value="{DynamicResource HomeRaisedSurfaceColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource HomeSelectionColor}" />
            <Setter Property="RenderTransform" Value="scale(1.05)" />
        </Style>
        <Style Selector="Button.homeQuickAction:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
        <Style Selector="Button.homePlayAction">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16">
                        <TransformOperationsTransition.Easing>
                            <CubicEaseOut />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.homePlayAction:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.06)" />
        </Style>
        <Style Selector="Button.homePlayAction:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>
    </UserControl.Styles>
    <Grid Background="{DynamicResource HomeBackgroundColor}" RowDefinitions="*,Auto,Auto">
        <ListBox
            Grid.Row="0"
            Margin="0,16"
            Padding="25,20"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            SelectedItem="{Binding GridSelectedApplication}"
            ContextFlyout="{Binding GridAppContextMenu}"
            DoubleTapped="GameList_DoubleTapped"
            ItemsSource="{Binding AppsObservableList}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="6" />
                    <Setter Property="CornerRadius" Value="12" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="RenderTransform" Value="scale(1)" />
                    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.18" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2">
                                <TransformOperationsTransition.Easing>
                                    <CubicEaseOut />
                                </TransformOperationsTransition.Easing>
                            </TransformOperationsTransition>
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="ListBoxItem:pointerover">
                    <Setter Property="Background" Value="{DynamicResource HomeAccentWashColor}" />
                    <Setter Property="RenderTransform" Value="scale(1.012)" />
                </Style>
                <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="{DynamicResource HomeAccentWashColor}" />
                    <Setter Property="RenderTransform" Value="scale(1.025)" />
                </Style>
                <Style Selector="ListBoxItem:focus">
                    <Setter Property="BorderBrush" Value="{DynamicResource HomeSelectionColor}" />
                </Style>
                <Style Selector="ListBoxItem:pressed">
                    <Setter Property="RenderTransform" Value="scale(0.99)" />
                </Style>
                <Style Selector="ListBoxItem Border.homeCoverFrame">
                    <Setter Property="BorderBrush" Value="{DynamicResource HomeBorderColor}" />
                    <Setter Property="Transitions">
                        <Transitions>
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.2" />
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="ListBoxItem:pointerover Border.homeCoverFrame">
                    <Setter Property="BorderBrush" Value="{DynamicResource HomeSelectionColor}" />
                </Style>
                <Style Selector="ListBoxItem:selected Border.homeCoverFrame">
                    <Setter Property="BorderBrush" Value="{DynamicResource HomeSelectionColor}" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ Rectangle#SelectionIndicator">
                    <Setter Property="Opacity" Value="0" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <StackPanel>
                            <Border
                                Classes="homeCoverFrame"
                                ClipToBounds="True"
                                CornerRadius="8"
                                BorderThickness="2"
                                BoxShadow="0 8 24 0 #33000000">
                                <Grid>
                                    <Image
                                        Classes.homeCover="True"
                                        Classes.small="{Binding $parent[UserControl].((viewModels:MainWindowViewModel)DataContext).IsGridSmall}"
                                        Classes.normal="{Binding $parent[UserControl].((viewModels:MainWindowViewModel)DataContext).IsGridMedium}"
                                        Classes.large="{Binding $parent[UserControl].((viewModels:MainWindowViewModel)DataContext).IsGridLarge}"
                                        Classes.huge="{Binding $parent[UserControl].((viewModels:MainWindowViewModel)DataContext).IsGridHuge}"
                                        Stretch="UniformToFill"
                                        Source="{Binding Icon, Converter={x:Static helpers:BitmapArrayValueConverter.Instance}}" />
                                    <Border
                                        Margin="4"
                                        Padding="5,2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource HomeSurfaceColor}"
                                        CornerRadius="5"
                                        IsVisible="{Binding HasIndependentConfiguration}">
                                        <TextBlock
                                            FontSize="10"
                                            Text="{ext:Locale GameSpecificConfigurationHeader}" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock
                                Margin="4,11,4,3"
                                MaxWidth="220"
                                FontSize="14"
                                FontWeight="SemiBold"
                                IsVisible="{Binding $parent[UserControl].((viewModels:MainWindowViewModel)DataContext).ShowNames}"
                                Text="{Binding Name}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ui:SymbolIcon
                            Margin="5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            FontSize="18"
                            Foreground="{DynamicResource FavoriteApplicationIconColor}"
                            IsVisible="{Binding Favorite}"
                            Symbol="StarFilled" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border
            Grid.Row="0"
            Width="340"
            Padding="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource HomeSurfaceColor}"
            BorderBrush="{DynamicResource HomeBorderColor}"
            BorderThickness="1"
            CornerRadius="18"
            IsVisible="{Binding !HasApplications}">
            <StackPanel HorizontalAlignment="Center" Spacing="18">
                <Border
                    Width="82"
                    Height="82"
                    HorizontalAlignment="Center"
                    Background="{DynamicResource HomeAccentWashColor}"
                    CornerRadius="41">
                    <ui:SymbolIcon
                        Symbol="Games"
                        FontSize="38"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource HomeSelectionColor}" />
                </Border>
                <Button
                    Classes="homeQuickAction"
                    Padding="20,9"
                    HorizontalAlignment="Center"
                    Command="{Binding OpenFile}"
                    Content="{ext:Locale MenuBarFileOpenFromFile}" />
            </StackPanel>
        </Border>
        <Border
            Name="SelectionPanel"
            Grid.Row="1"
            Margin="30,0,30,14"
            Padding="14"
            Background="{DynamicResource HomeSurfaceColor}"
            BorderBrush="{DynamicResource HomeBorderColor}"
            BorderThickness="1"
            BoxShadow="0 8 26 0 #24000000"
            CornerRadius="14"
            IsVisible="{Binding HasGridSelection}">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.24" />
                </Transitions>
            </Border.Transitions>
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Image
                    Grid.Column="0"
                    Width="56"
                    Height="56"
                    Source="{Binding GridSelectedApplication.Icon, Converter={x:Static helpers:BitmapArrayValueConverter.Instance}}" />
                <StackPanel
                    Grid.Column="1"
                    Margin="18,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{Binding GridSelectedApplication.Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,5,0,0"
                        Foreground="{DynamicResource HomeMutedTextColor}"
                        Text="{Binding GridSelectedApplication.Developer}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Classes="homePlayAction"
                    Width="56"
                    Height="56"
                    MinWidth="56"
                    VerticalAlignment="Center"
                    Background="{DynamicResource HomeSelectionColor}"
                    CornerRadius="28"
                    Click="PlaySelected_OnClick"
                    ToolTip.Tip="{Binding GridSelectedApplication.Name}">
                    <ui:SymbolIcon Symbol="Play" Foreground="{DynamicResource HomePlayForegroundColor}" />
                </Button>
            </Grid>
        </Border>
        <StackPanel
            Grid.Row="2"
            Margin="30,0,30,18"
            HorizontalAlignment="Stretch"
            Orientation="Vertical"
            Spacing="17">
            <Border
                Height="1"
                Background="{DynamicResource HomeBorderColor}" />
            <StackPanel
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                Spacing="22">
                <Button
                    Classes="homeQuickAction"
                    Width="54"
                    Height="54"
                    MinWidth="54"
                    CornerRadius="27"
                    Command="{Binding OpenFile}"
                    ToolTip.Tip="{ext:Locale MenuBarFileOpenFromFile}">
                    <ui:SymbolIcon Symbol="Add" FontSize="24" />
                </Button>
                <Button
                    Classes="homeQuickAction"
                    Width="54"
                    Height="54"
                    MinWidth="54"
                    CornerRadius="27"
                    Command="{Binding OpenFolder}"
                    ToolTip.Tip="{ext:Locale MenuBarFileOpenUnpacked}">
                    <ui:SymbolIcon Symbol="Folder" FontSize="24" />
                </Button>
                <Button
                    Classes="homeQuickAction"
                    Width="54"
                    Height="54"
                    MinWidth="54"
                    CornerRadius="27"
                    Click="OpenSettings_OnClick"
                    ToolTip.Tip="{ext:Locale MenuBarOptionsSettings}">
                    <ui:SymbolIcon Symbol="Settings" FontSize="24" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
