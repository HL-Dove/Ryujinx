<UserControl
    x:Class="Ryujinx.Ava.UI.Controls.ApplicationGridView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:helpers="clr-namespace:Ryujinx.Ava.UI.Helpers"
    xmlns:icons="https://github.com/projektanker/icons.avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:profiles="clr-namespace:Ryujinx.HLE.HOS.Services.Account.Acc;assembly=Ryujinx.HLE"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    d:DesignHeight="1080"
    d:DesignWidth="1920"
    Focusable="True"
    FlowDirection="LeftToRight"
    mc:Ignorable="d"
    x:DataType="viewModels:MainWindowViewModel">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="HomeFocusBrush" StartPoint="0%,100%" EndPoint="100%,0%">
            <GradientStop Offset="0" Color="#1688FF" />
            <GradientStop Offset="0.52" Color="#9272EF" />
            <GradientStop Offset="1" Color="#64DFFF" />
        </LinearGradientBrush>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Button.homeDock">
            <Setter Property="Width" Value="124" />
            <Setter Property="Height" Value="124" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="5" />
            <Setter Property="CornerRadius" Value="62" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="Button.homeDock:pointerover">
            <Setter Property="Background" Value="#393939" />
            <Setter Property="BorderBrush" Value="{StaticResource HomeFocusBrush}" />
        </Style>
        <Style Selector="Button.homeDock:focus">
            <Setter Property="Background" Value="#393939" />
            <Setter Property="BorderBrush" Value="{StaticResource HomeFocusBrush}" />
        </Style>
        <Style Selector="Button.homeDock.homeSelected">
            <Setter Property="Background" Value="#393939" />
            <Setter Property="BorderBrush" Value="{StaticResource HomeFocusBrush}" />
        </Style>
        <Style Selector="Button.homeFooterAction">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#D5D5D8" />
        </Style>
        <Style Selector="Button.homeFooterAction:pointerover">
            <Setter Property="Foreground" Value="#30BEFF" />
        </Style>
    </UserControl.Styles>
    <Grid Background="#1B1B1B">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Canvas Name="HomeCanvas" Width="1920" Height="1080" Background="#1B1B1B">
                <ItemsControl Canvas.Left="73" Canvas.Top="69" ItemsSource="{Binding HomeProfiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="18" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="profiles:UserProfile">
                            <Button Width="94" Height="94" MinWidth="94" MinHeight="94" Padding="5"
                                    Background="#383838" BorderThickness="0" CornerRadius="47"
                                    Click="OpenProfiles_OnClick"
                                    ToolTip.Tip="{ext:Locale MenuBarOptionsManageUserProfiles}">
                                <Border Width="82" Height="82" ClipToBounds="True" CornerRadius="41">
                                    <Image Stretch="UniformToFill" Source="{Binding Image, Converter={x:Static helpers:BitmapArrayValueConverter.Instance}}" />
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Canvas.Left="73" Canvas.Top="69" Width="94" Height="94" MinWidth="94" MinHeight="94"
                        Background="#383838" BorderThickness="0" CornerRadius="47"
                        IsVisible="{Binding !HasHomeProfiles}" Click="OpenProfiles_OnClick"
                        ToolTip.Tip="{ext:Locale MenuBarOptionsManageUserProfiles}">
                    <icons:Icon Value="mdi-account" FontSize="56" Foreground="#D2D2D5" />
                </Button>
                <TextBlock Name="HomeClock" Canvas.Right="73" Canvas.Top="82" Width="160"
                           FontSize="43" FontWeight="SemiBold" Foreground="#D2D2D5"
                           Text="--:--" TextAlignment="Right" />

                <StackPanel Name="GameTitle" Canvas.Left="31" Canvas.Top="231" Orientation="Horizontal" Spacing="19" IsVisible="False">
                    <icons:Icon Width="43" Value="mdi-cellphone" FontSize="43" Foreground="#E60012" />
                    <TextBlock Name="GameTitleName" Width="630" FontSize="30" FontWeight="Bold" Foreground="#27BEF5"
                               Text="{Binding GridSelectedApplication.Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ListBox Name="GameListBox" Canvas.Left="147" Canvas.Top="289" Width="1773" Height="411"
                         Padding="0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectedItem="{Binding GridSelectedApplication}"
                         ContextFlyout="{Binding GridAppContextMenu}"
                         DoubleTapped="GameList_DoubleTapped"
                         SelectionChanged="GameList_SelectionChanged"
                         KeyDown="GameList_KeyDown"
                         GotFocus="GameList_GotFocus" LostFocus="GameList_LostFocus"
                         ItemsSource="{Binding AppsObservableList}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Width" Value="406" />
                            <Setter Property="Height" Value="406" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusAdorner" Value="{x:Null}" />
                            <Setter Property="Template">
                                <ControlTemplate>
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </ControlTemplate>
                            </Setter>
                        </Style>
                        <Style Selector="Border.homeSelectionRing">
                            <Setter Property="BorderBrush" Value="Transparent" />
                        </Style>
                        <Style Selector="ListBox.gameFocused ListBoxItem:selected Border.homeSelectionRing">
                            <Setter Property="BorderBrush" Value="{StaticResource HomeFocusBrush}" />
                        </Style>
                        <Style Selector="ListBoxItem:pointerover Border.homeSelectionRing">
                            <Setter Property="BorderBrush" Value="{StaticResource HomeFocusBrush}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="406" Height="406" Background="#1B1B1B">
                                <Border Width="384" Height="384" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="#303030" ClipToBounds="True" CornerRadius="22">
                                    <Image Width="384" Height="384" Stretch="UniformToFill"
                                           Source="{Binding Icon, Converter={x:Static helpers:BitmapArrayValueConverter.Instance}}" />
                                </Border>
                                <Border Classes="homeSelectionRing" Background="Transparent"
                                        BorderThickness="5" CornerRadius="35"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Name="RunningPlayerAvatar" Width="84" Height="84"
                      IsVisible="False" IsHitTestVisible="False">
                    <Border CornerRadius="42" Background="#383838" ClipToBounds="True">
                        <Grid>
                            <icons:Icon Value="mdi-account" FontSize="43" Foreground="White"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Stretch="UniformToFill"
                                   Source="{Binding HomeProfiles[0].Image, Converter={x:Static helpers:BitmapArrayValueConverter.Instance}}" />
                        </Grid>
                    </Border>
                    <Border CornerRadius="42" Background="Transparent"
                            BorderBrush="White" BorderThickness="5" />
                </Grid>
                <Border Name="RunningGameBadge" Width="255" Height="82" CornerRadius="41"
                        Background="Black" BorderBrush="White" BorderThickness="4"
                        IsVisible="False" IsHitTestVisible="False">
                    <TextBlock Text="正在游玩" FontSize="30" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Canvas.Left="700" Canvas.Top="380" Width="520" Spacing="18"
                            HorizontalAlignment="Center" IsVisible="{Binding !HasApplications}">
                    <icons:Icon Value="mdi-gamepad-variant" FontSize="78" Foreground="#BDBDC2" HorizontalAlignment="Center" />
                    <TextBlock FontSize="30" TextAlignment="Center" Text="{ext:Locale HomeNoGames}" />
                    <Button Padding="24,13" HorizontalAlignment="Center" Command="{Binding OpenFile}"
                            Content="{ext:Locale MenuBarFileOpenFromFile}" />
                </StackPanel>

                <Border Canvas.Left="333" Canvas.Top="770" Width="1254" Height="140"
                        Background="#303030" CornerRadius="70" />
                <StackPanel Name="DockBar" Canvas.Left="340" Canvas.Top="778" Orientation="Horizontal"
                            KeyDown="DockBar_KeyDown">
                    <Button Name="DockOnline" Classes="homeDock" Tag="Nintendo Switch Online"
                            Click="FocusGames_OnClick" GotFocus="DockAction_GotFocus" LostFocus="DockAction_LostFocus"
                            ToolTip.Tip="游戏库">
                        <Grid Width="96" Height="96">
                            <Ellipse Fill="#E60012" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="1">
                                <icons:Icon Value="mdi-nintendo-switch" FontSize="38" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock FontSize="12" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Text="ONLINE" />
                            </StackPanel>
                            <Ellipse Width="15" Height="15" Fill="#20C7F4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-5,0" />
                        </Grid>
                    </Button>
                    <Button Classes="homeDock" Tag="相册" Click="OpenScreenshots_OnClick"
                            GotFocus="DockAction_GotFocus" LostFocus="DockAction_LostFocus"
                            ToolTip.Tip="{ext:Locale MenuBarFileOpenScreenshotsFolder}">
                        <icons:Icon Value="mdi-image-outline" FontSize="57" Foreground="#D57027" />
                    </Button>
                    <Button Classes="homeDock" Tag="游戏目录" Click="OpenFolder_OnClick"
                            GotFocus="DockAction_GotFocus" LostFocus="DockAction_LostFocus"
                            ToolTip.Tip="{ext:Locale MenuBarFileOpenUnpacked}">
                        <icons:Icon Value="mdi-newspaper-variant-outline" FontSize="57" Foreground="#27B36B" />
                    </Button>
                    <Button Classes="homeDock" Tag="打开游戏" Click="OpenFile_OnClick"
                            GotFocus="DockAction_GotFocus" LostFocus="DockAction_LostFocus"
                            ToolTip.Tip="{ext:Locale MenuBarFileOpenFromFile}">
                        <icons:Icon Value="mdi-shopping-outline" FontSize="57" Foreground="#E1574B" />
                    </Button>
                    <Button Classes="homeDock" Tag="截图" Click="OpenScreenshots_OnClick"
                            GotFocus="DockAction_GotFocus" LostFocus="DockAction_LostFocus"
                            ToolTip.Tip="{ext:Locale MenuBarFileOpenScreenshotsFolder}">
                        <icons:Icon Value="mdi-image-multiple-outline" FontSize="57" Foreground="#559FEE" />
                    </Button>
                    <Button Classes="homeDock" Tag="网络" Click="OpenNetworkSettings_OnClick"
                            GotFocus="DockAction_GotFocus" LostFocus="DockAction_LostFocus"
                            ToolTip.Tip="{ext:Locale MenuBarOptionsSettings}">
                        <icons:Icon Value="mdi-access-point" FontSize="57" Foreground="#20AFAC" />
                    </Button>
                    <Button Classes="homeDock" Tag="手柄" Click="OpenInputSettings_OnClick"
                            GotFocus="DockAction_GotFocus" LostFocus="DockAction_LostFocus"
                            ToolTip.Tip="{ext:Locale SettingsTabInput}">
                        <Grid Width="37" Height="68" RenderTransform="rotate(45deg)">
                            <Border CornerRadius="12" BorderBrush="#A9A9B3" BorderThickness="5" />
                            <Ellipse Width="11" Height="11" Margin="0,12,0,0" HorizontalAlignment="Center"
                                     VerticalAlignment="Top" Fill="#A9A9B3" />
                            <Ellipse Width="5" Height="5" Margin="10,39,0,0" HorizontalAlignment="Left"
                                     VerticalAlignment="Top" Fill="#A9A9B3" />
                            <Ellipse Width="5" Height="5" Margin="21,39,0,0" HorizontalAlignment="Left"
                                     VerticalAlignment="Top" Fill="#A9A9B3" />
                            <Ellipse Width="5" Height="5" Margin="10,50,0,0" HorizontalAlignment="Left"
                                     VerticalAlignment="Top" Fill="#A9A9B3" />
                            <Ellipse Width="5" Height="5" Margin="21,50,0,0" HorizontalAlignment="Left"
                                     VerticalAlignment="Top" Fill="#A9A9B3" />
                        </Grid>
                    </Button>
                    <Button Classes="homeDock" Tag="主机" Click="OpenSystemSettings_OnClick"
                            GotFocus="DockAction_GotFocus" LostFocus="DockAction_LostFocus"
                            ToolTip.Tip="{ext:Locale MenuBarOptionsSettings}">
                        <icons:Icon Value="mdi-cellphone" FontSize="57" Foreground="#A9A9B3" />
                    </Button>
                    <Button Classes="homeDock" Tag="设置" Click="OpenSettings_OnClick"
                            GotFocus="DockAction_GotFocus" LostFocus="DockAction_LostFocus"
                            ToolTip.Tip="{ext:Locale MenuBarOptionsSettings}">
                        <icons:Icon Value="mdi-cog-outline" FontSize="57" Foreground="#A9A9B3" />
                    </Button>
                    <Button Classes="homeDock" Tag="电源" Click="CloseWindow_OnClick"
                            GotFocus="DockAction_GotFocus" LostFocus="DockAction_LostFocus" ToolTip.Tip="退出 Ryujinx">
                        <icons:Icon Value="mdi-power" FontSize="57" Foreground="#A9A9B3" />
                    </Button>
                </StackPanel>
                <TextBlock Name="DockLabel" Canvas.Top="913" Width="550" FontSize="35"
                           FontWeight="SemiBold" Foreground="#28C4F4" TextAlignment="Center" IsVisible="False" />

                <Button Name="OptionsPrompt" Canvas.Right="100" Canvas.Top="997"
                        Classes="homeFooterAction" Click="ShowOptions_OnClick" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="35" Height="35" CornerRadius="18" Background="#D2D2D5">
                            <TextBlock Text="+" FontSize="30" FontWeight="Bold" Foreground="#1B1B1B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="选项" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Name="CloseGamePrompt" Canvas.Right="300" Canvas.Top="997"
                        Classes="homeFooterAction" Click="CloseRunningGame_OnClick" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border Width="35" Height="35" CornerRadius="18" Background="#D2D2D5">
                            <TextBlock Text="X" FontSize="25" FontWeight="Bold" Foreground="#1B1B1B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="关闭软件" FontSize="32" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Canvas Name="LaunchAnimationLayer" Canvas.Left="0" Canvas.Top="0"
                        Width="1920" Height="1080" ClipToBounds="True"
                        IsVisible="False" IsHitTestVisible="True">
                    <Border Name="LaunchDim" Width="1920" Height="1080"
                            Background="#1B1B1B" Opacity="0" />
                    <Border Name="LaunchGhost" ClipToBounds="True" CornerRadius="28" Opacity="0">
                        <Image Stretch="UniformToFill"
                               Source="{Binding SelectedIcon, Converter={x:Static helpers:BitmapArrayValueConverter.Instance}}" />
                    </Border>
                </Canvas>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
